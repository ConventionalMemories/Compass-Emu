 164   33  0  0         PROCEDURE FloatTest;
 165   34  1  0         VAR j: INTEGER;
 166   35  1  0         BEGIN
 166   36  1  1         x := 1.0;
 167   37  1  1         FOR j := 1 TO 200 DO x := x * 1.01 + 0.5;
 169   38  1  1         END;
                        
 170   40  0  0         FUNCTION Work (n: INTEGER): INTEGER;
 171   41  1  0         VAR j, t: INTEGER;
 172   42  1  0         BEGIN
 172   43  1  1         t := 0;
 173   44  1  1         FOR j := 1 TO 50 DO t := t + (n MOD 7) * j;
 175   45  1  1         Work := t;
 176   46  1  1         END;
                        
 177   48  0  0         PROCEDURE ShowError;
 178   49  1  0         BEGIN
 178   50  1  1         OsDecodeException (2, msg);
 179   51  1  1         END;
                        
 180   53  0  0         BEGIN
